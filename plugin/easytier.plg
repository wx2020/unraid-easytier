<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN
  name="easytier"
  author="wx2020"
  version="2026.08.06.0001"
  launch="Settings/EasyTier"
  pluginURL="https://github.com/wx2020/unraid-easytier/releases/latest/download/easytier.plg"
  support="https://github.com/wx2020/unraid-easytier/issues"
  min="6.12.14"
>

<CHANGES>
<![CDATA[

### 2026.08.06.0001

- Moved the EasyTier WebUI entry into Settings > Network Services
- Kept EasyTier settings and logs as nested pages under the plugin entry

### 2026.07.28.0003

- Added Community Applications repository and plugin metadata
- Added complete GPLv3 license text
- Updated plugin support and self-update links
- Added EasyTier project introduction and official resource links
- Added automated Community Applications XML validation

### 2026.07.28.0002

- Fixed utils package installation into the Unraid filesystem
- Fixed WebUI function imports that could cause blank pages
- Fixed error-page fallback rendering and diagnostics
- Improved light and dark theme compatibility
- Added runtime WebUI rendering checks to CI

### 2026.07.28.0001

- Fixed runtime class loading and service installation
- Fixed settings persistence, log rendering, and watcher recovery
- Added safe argument generation and peer hostname synchronization
- Hardened config writes and unified release versioning

### 2026.02.24.0001

### 🐛 Bug Fixes

- 修复 WebUI 空白页面问题
- 添加 EasyTier.page 入口文件
- 创建 BaseUtils 和 BaseSystem 基础类
- 更新 common.php 支持手动加载类文件
- 修复缺少 EDACerton\PluginUtils 基类导致的加载失败

### 2026.02.22.0001

### 🎉 Initial Release

- Initial release of EasyTier plugin for Unraid
- Support for EasyTier networking
- Web UI for configuration
- Automatic interface registration

]]>
</CHANGES>

<!--
EasyTier binary package
Note: Update the URL and SHA256 for each release
-->
<FILE Name="/boot/config/plugins/easytier/EASYTIER_ASSET">
<URL>EASYTIER_ASSET_URL</URL>
<SHA256>EASYTIER_ASSET_SHA256</SHA256>
</FILE>

<!--
EasyTier Utils package (PHP files, styles, etc.)
Note: Update the URL and SHA256 for each release
-->
<FILE Name="/boot/config/plugins/easytier/unraid-easytier-utils-2026.08.06.0001-noarch-1.txz">
<URL>https://github.com/wx2020/unraid-easytier/releases/download/2026.08.06.0001/unraid-easytier-utils-2026.08.06.0001-noarch-1.txz</URL>
<SHA256>PLACEHOLDER_SHA256</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
if [ -d "/usr/local/emhttp/plugins/easytier" ]; then
    rm -rf /usr/local/emhttp/plugins/easytier
fi

# Remove old symlink if it exists
if [ -L "/etc/rc.d/rc.easytier" ]; then
    rm -f /etc/rc.d/rc.easytier
fi

# Extract EasyTier binary
mkdir -p /usr/local/emhttp/plugins/easytier/bin
EASYTIER_ARCHIVE="/boot/config/plugins/easytier/EASYTIER_ASSET"
unzip -o "$EASYTIER_ARCHIVE" -d /usr/local/emhttp/plugins/easytier/bin

# Extract utils package (PHP files, styles, etc.)
UTILS_PKG="/boot/config/plugins/easytier/unraid-easytier-utils-2026.08.06.0001-noarch-1.txz"
if [ -n "$UTILS_PKG" ]; then
    mkdir -p /tmp/easytier-utils
    tar -xf "$UTILS_PKG" -C /tmp/easytier-utils
    # Install from utils package (find the versioned directory)
    UTILS_DIR=$(ls -d /tmp/easytier-utils/unraid-easytier-utils-* 2>/dev/null | head -n 1)
    if [ -n "$UTILS_DIR" ] && [ -f "$UTILS_DIR/install/doinst.sh" ]; then
        cp -a "$UTILS_DIR/etc/." /etc/
        cp -a "$UTILS_DIR/usr/." /usr/
        /bin/bash "$UTILS_DIR/install/doinst.sh"
    else
        echo "EasyTier utils package has an invalid structure."
        rm -rf /tmp/easytier-utils
        exit 1
    fi
    rm -rf /tmp/easytier-utils
else
    echo "EasyTier utils package was not found."
    exit 1
fi

# Create symlinks for easy access
EASYTIER_CORE=$(find /usr/local/emhttp/plugins/easytier/bin -type f -name easytier-core | head -n 1)
EASYTIER_BIN_DIR=$(dirname "$EASYTIER_CORE")
if [ ! -x "$EASYTIER_BIN_DIR/easytier-core" ] || [ ! -x "$EASYTIER_BIN_DIR/easytier-cli" ]; then
    echo "EasyTier binaries were not found in the release archive."
    exit 1
fi
ln -sf "$EASYTIER_BIN_DIR/easytier-core" /usr/local/sbin/easytier-core
ln -sf "$EASYTIER_BIN_DIR/easytier-cli" /usr/local/sbin/easytier-cli

# Create log file if it doesn't exist
touch /var/log/easytier.log
chmod 0644 /var/log/easytier.log

# Create config directory if it doesn't exist
mkdir -p /boot/config/plugins/easytier

# Start EasyTier service
/usr/local/emhttp/plugins/easytier/restart.sh

# Cleanup old versions
find /boot/config/plugins/easytier -name '*.zip' ! -name 'EASYTIER_ASSET' -type f -delete 2>/dev/null || true
# Keep only the current utils txz file (the one that was just downloaded)
UTILS_PKG="/boot/config/plugins/easytier/unraid-easytier-utils-2026.08.06.0001-noarch-1.txz"
if [ -n "$UTILS_PKG" ]; then
    find /boot/config/plugins/easytier -name '*.txz' ! -name "$(basename "$UTILS_PKG")" -type f -delete 2>/dev/null || true
fi

echo ""
echo "----------------------------------------------------"
echo " EasyTier has been installed."
echo " Version: 2026.08.06.0001"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
# Stop service
/etc/rc.d/rc.easytier stop 2>/dev/null

rm -f /usr/local/sbin/easytier-*

rm -rf /usr/local/emhttp/plugins/easytier
rm -rf /usr/local/php/easytier-utils
rm -f /etc/rc.d/rc.easytier /etc/cron.daily/easytier-daily
rm -f /etc/sysctl.d/99-easytier.conf
rm -f /boot/config/plugins/easytier/*.zip
]]>
</INLINE>
</FILE>

</PLUGIN>
