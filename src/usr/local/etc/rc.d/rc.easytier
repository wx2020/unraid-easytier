#!/bin/sh
# /etc/rc.d/rc.easytier - start/stop the EasyTier service

. /usr/local/php/easytier-utils/log.sh

network_is_ready() {
  # If ip is unavailable, do not block service startup indefinitely.
  if ! command -v ip >/dev/null 2>&1; then
    return 0
  fi

  if ip route show default 2>/dev/null | grep -q '^default '; then
    return 0
  fi

  # P1 R-04: more robust check - route get and link up state
  if ip route get 1.1.1.1 2>/dev/null | grep -q ' dev '; then
    return 0
  fi

  # Require interface to be UP and have global address
  if command -v ip >/dev/null 2>&1; then
    # Check for any UP non-lo/easytier interface with global address
    ip -o link show up 2>/dev/null | grep -q '^[0-9]' || return 1
    ip -o addr show scope global up 2>/dev/null |
      awk '$2 != "lo" && $2 != "easytier0" { found=1 } END { exit found ? 0 : 1 }'
    return $?
  fi
  return 1
}

wait_for_network() {
  network_timeout=60
  network_interval=2
  elapsed=0

  while ! network_is_ready; do
    if [ "$elapsed" -ge "$network_timeout" ]; then
      # P1 R-03: explicit WARNING for watcher to shorten retry
      log "WARNING: Network readiness wait timed out after ${elapsed}s; starting EasyTier and allowing reconnect."
      return 0
    fi

    sleep "$network_interval"
    elapsed=$((elapsed + network_interval))
  done

  log "System network is ready."
}

start_easytier() {
  # P1 R-08: flock at rc entry to serialize start/stop
  exec 9>/var/lock/easytier-rc.lock 2>/dev/null || exec 9>/tmp/easytier-rc.lock
  flock -n 9 2>/dev/null || { log "Another rc.easytier operation in progress, aborting."; return 1; }
  if ! /usr/bin/pgrep --ns $$ --euid root -f "^/usr/local/sbin/easytier-core" 1> /dev/null 2> /dev/null ; then

    /usr/local/php/easytier-utils/pre-startup.php
    if [ $? -ne 0 ]; then
        log "EasyTier is disabled in settings, not starting easytier-core."
        return
    fi

    wait_for_network

    # P0 S-01: eval-free argument loading. custom-params.sh is now one arg per line.
    ARGS_FILE="/usr/local/emhttp/plugins/easytier/custom-params.sh"
    LEGACY_ARGS="/boot/config/plugins/easytier/args.txt"
    if [ ! -f "$ARGS_FILE" ] && [ -f "$LEGACY_ARGS" ]; then
        ARGS_FILE="$LEGACY_ARGS"
    fi

    # Create state directory with secure permissions (P0 S-03)
    mkdir -p /boot/config/plugins/easytier/state
    chmod 0700 /boot/config/plugins/easytier 2>/dev/null || true
    chmod 0700 /boot/config/plugins/easytier/state 2>/dev/null || true

    log "Starting EasyTier."

    # Build argument list without eval (P0 S-01/S-02)
    set -- --dhcp --dev-name easytier0
    # Load persisted args if available; support both new line-per-arg format and legacy shell-var format
    if [ -f "$ARGS_FILE" ]; then
        # Detect legacy format: file contains EASYTIER_CUSTOM_PARAMS=
        if grep -q "EASYTIER_CUSTOM_PARAMS" "$ARGS_FILE" 2>/dev/null; then
            # Legacy: source and eval single outer layer into positional params
            # shellcheck disable=SC1090
            . "$ARGS_FILE"
            # shellcheck disable=SC2086
            eval "set -- $EASYTIER_CUSTOM_PARAMS"
            # Re-add base args that are now in $@ already? Legacy file already contains base, so reset
            # Keep $@ as is (already includes --dhcp etc from file)
            :
        else
            # New format: one arg per line
            set --
            while IFS= read -r _arg || [ -n "$_arg" ]; do
                [ -z "$_arg" ] && continue
                set -- "$@" "$_arg"
            done < "$ARGS_FILE"
        fi
    fi

    # Start EasyTier in background with logging (eval-free exec)
    # shellcheck disable=SC2086
    /usr/local/sbin/easytier-core "$@" >> /var/log/easytier.log 2>&1 &

    # Start the watcher process
    if ! /usr/bin/pgrep --ns $$ --euid root -f "easytier-watcher.php" >/dev/null 2>&1; then
      nohup /usr/local/emhttp/plugins/easytier/easytier-watcher.php >/dev/null 2>&1 &
    fi
  fi
}

stop_easytier() {
  log "Stopping EasyTier."
  /usr/bin/pkill --ns $$ --euid root -f "easytier-watcher.php" 2> /dev/null || true
  killall --ns $$ --wait easytier-core 2> /dev/null
}

restart_easytier() {
  stop_easytier
  sleep 1
  start_easytier
}

case "$1" in
'start')
  start_easytier
  ;;
'stop')
  stop_easytier
  ;;
'restart')
  restart_easytier
  ;;
*)
  echo "usage $0 start|stop|restart"
esac
